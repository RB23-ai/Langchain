# === Required for most modules ===
OPENAI_API_KEY=sk-...
# OR pick a free alternative:
GROQ_API_KEY=gsk_...
ANTHROPIC_API_KEY=sk-ant-...

# === Embeddings (free open-source default) ===
# Uses HuggingFace sentence-transformers — no key needed

# === Vector DBs (only set the one you use) ===
PINECONE_API_KEY=
WEAVIATE_URL=
WEAVIATE_API_KEY=

# === Tools ===
TAVILY_API_KEY=          # free tier 1000/mo, better than DuckDuckGo for agents
SERPER_API_KEY=
WEATHERSTACK_API_KEY=

# === Observability (free tier, highly recommended) ===
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langchain-mastery